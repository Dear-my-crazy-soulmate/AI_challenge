# Copy to .env.local and fill in values. Never commit .env.local.

# --- Supabase (Step 3) ---
# Public: safe to expose to the browser (protected by RLS)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Secret: server-only, never prefix with NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=

# --- LLM (Step 1) ---
# "mock" until the ChatKHU API method is confirmed
LLM_PROVIDER=mock
# Secret: server-only. Name/endpoint to be decided once ChatKHU is confirmed.
LLM_API_KEY=
