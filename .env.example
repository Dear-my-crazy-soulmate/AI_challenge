# Copy to .env.local and fill in values. Never commit .env.local.

# --- Supabase (Step 3) ---
# Public: safe to expose to the browser (protected by RLS)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Secret: server-only, never prefix with NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=

# --- ChatKHU (BAZE API Gateway, OpenAI-compatible) ---
# Secret: server-only, never prefix with NEXT_PUBLIC_. Without these the AI card shows the book's text instead.
CHATKHU_API_KEY=
CHATKHU_BASE_URL=https://factchat-cloud.mindlogic.ai/v1/gateway
# Optional, default claude-haiku-5-5
CHATKHU_MODEL=
